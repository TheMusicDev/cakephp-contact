{
    "name": "themusicdev/contact",
    "description": "CakePHP 5 plugin: contact-form intake with an inquiries table and honeypot / submit-timing spam handling",
    "type": "cakephp-plugin",
    "keywords": ["cakephp", "plugin", "contact-form", "spam-protection", "honeypot", "inquiries"],
    "homepage": "https://github.com/TheMusicDev/cakephp-contact",
    "license": "MIT",
    "authors": [
        {
            "name": "TheMusicDev",
            "homepage": "https://themusicdev.llc"
        }
    ],
    "support": {
        "issues": "https://github.com/TheMusicDev/cakephp-contact/issues",
        "source": "https://github.com/TheMusicDev/cakephp-contact"
    },
    "require": {
        "php": ">=8.2",
        "cakephp/cakephp": "^5.2"
    },
    "require-dev": {
        "cakephp/cakephp-codesniffer": "^5.3",
        "cakephp/migrations": "^5.0",
        "captainhook/captainhook": "^5.29",
        "captainhook/plugin-composer": "^5.3",
        "phpstan/phpstan": "^2",
        "phpunit/phpunit": "^11.5.3 || ^12.1.3 || ^13.0",
        "ramsey/conventional-commits": "^1.7"
    },
    "suggest": {
        "cakephp/migrations": "Needed to create the inquiries table (bin/cake migrations migrate -p TheMusicDev/Contact)"
    },
    "autoload": {
        "psr-4": {
            "TheMusicDev\\Contact\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "TheMusicDev\\Contact\\Test\\": "tests/",
            "TestApp\\": "tests/test_app/src/"
        }
    },
    "scripts": {
        "check": [
            "@test",
            "@cs-check",
            "@stan"
        ],
        "cs-check": "phpcs --colors -p",
        "cs-fix": "phpcbf --colors -p",
        "stan": "phpstan analyse --no-progress --memory-limit=512M",
        "test": "phpunit --colors=always"
    },
    "config": {
        "allow-plugins": {
            "captainhook/plugin-composer": true,
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "cakephp/plugin-installer": true
        },
        "sort-packages": true
    }
}
